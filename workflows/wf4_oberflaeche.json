var(--onacc);white-space:pre-wrap}.a{align-self:flex-start;background:var(--card);border:1px solid var(--line)}.a p{margin:0 0 .6em}.a p:last-child{margin-bottom:0}.a ul,.a ol{margin:.3em 0;padding-left:1.3em}.a a{color:var(--acc)}.a.err{background:var(--err);color:var(--errt);border-color:var(--errt)}.a.wait{color:var(--mut)}.dots i{display:inline-block;width:7px;height:7px;margin-right:4px;border-radius:50%;background:var(--mut);animation:b 1.2s infinite ease-in-out}.dots i:nth-child(2){animation-delay:.2s}.dots i:nth-child(3){animation-delay:.4s}@keyframes b{0%,80%,100%{opacity:.25}40%{opacity:1}}@media (prefers-reduced-motion:reduce){.dots i{animation:none}}.fb{margin-top:8px;padding-top:6px;border-top:1px solid var(--line);color:var(--mut);font-size:.88rem;display:flex;align-items:center;gap:8px;flex-wrap:wrap}.fb button{padding:4px 10px}.ex{display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ex p{margin:0;color:var(--mut)}.ex button{text-align:left}form{display:flex;gap:8px;align-items:flex-end}textarea{flex:1;font:inherit;color:var(--text);background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px;resize:none;max-height:160px}#send{background:var(--acc);color:var(--onacc);border-color:var(--acc);font-weight:600}:focus-visible{outline:3px solid var(--acc);outline-offset:2px}</style></head><body><div class='app'><header><div><h1>KI-Kompass – Ihr Ratgeber zum KI-Konzept</h1><p class='hint'>Sie chatten mit einem KI-Assistenten. Antworten können Fehler enthalten – maßgeblich ist das KI-Konzept; bitte die Seitenangabe prüfen. Bitte keine Namen oder persönlichen Daten eingeben. Ihre Fragen werden nicht gespeichert – nur bei technischen Fehlern vorübergehend zur Fehlerbehebung.</p></div><button id='tg' type='button'>Hell / Dunkel</button></header><div id='log' aria-live='polite'><div id='ex' class='ex'><p>Beispielfragen zum Ausprobieren:</p><button type='button'>Dürfen Schüler:innen KI für Hausaufgaben nutzen?</button><button type='button'>Wie bewerte ich ein KI-gestütztes Projekt?</button><button type='button'>Was bedeutet das Ampelsystem im Unterricht?</button><button type='button'>Wie informiere ich Eltern über den KI-Einsatz?</button></div></div><form id='f'><textarea id='in' rows='1' placeholder='Ihre Frage zum KI-Konzept …' aria-label='Ihre Frage'></textarea><button id='send' type='submit'>Senden</button></form></div><script src='https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js'></script><script src='https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js'></script><script>var CHAT='/webhook/ki-kompass-<SUFFIX>-frage',FB='/webhook/ki-kompass-<SUFFIX>-feedback';var sid=(window.crypto&&crypto.randomUUID)?crypto.randomUUID():String(Date.now())+Math.random().toString(16).slice(2);var log=document.getElementById('log'),inp=document.getElementById('in'),snd=document.getElementById('send'),busy=false;if(window.DOMPurify){DOMPurify.addHook('afterSanitizeAttributes',function(n){if(n.tagName==='A'){n.setAttribute('target','_blank');n.setAttribute('rel','noopener noreferrer')}})}function down(){log.scrollTop=log.scrollHeight}function add(c){var d=document.createElement('div');d.className='m '+c;log.appendChild(d);down();return d}function render(el,t){if(window.marked&&window.DOMPurify){el.innerHTML=DOMPurify.sanitize(marked.parse(t,{breaks:true}),{FORBID_TAGS:['img','style','form','input','button','iframe'],FORBID_ATTR:['style']})}else{el.textContent=t}}function fbBox(){var b=document.createElement('div');b.className='fb';var q=document.createElement('span');q.textContent='War die Antwort hilfreich?';var y=document.createElement('button');y.type='button';y.textContent='👍';y.setAttribute('aria-label','Hilfreich');var n=document.createElement('button');n.type='button';n.textContent='👎';n.setAttribute('aria-label','Nicht hilfreich');var sent=false;function go(v){if(sent)return;sent=true;y.disabled=n.disabled=true;fetch(FB,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({bewertung:v})}).then(function(r){if(!r.ok)throw new Error(r.status);b.textContent='Danke für Ihr Feedback'}).catch(function(){sent=false;y.disabled=n.disabled=false;q.textContent='Das Feedback konnte gerade nicht gesendet werden. Bitte erneut versuchen.'})}y.onclick=function(){go('positiv')};n.onclick=function(){go('negativ')};b.appendChild(q);b.appendChild(y);b.appendChild(n);return b}function ask(t){t=String(t||'').trim();if(!t||busy)return;busy=true;inp.disabled=snd.disabled=true;var ex=document.getElementById('ex');if(ex)ex.remove();add('u').textContent=t;var w=add('a wait');w.innerHTML='<span class=dots><i></i><i></i><i></i></span> Der KI-Kompass antwortet …';fetch(CHAT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'sendMessage',sessionId:sid,chatInput:t})}).then(function(r){if(!r.ok)throw new Error(r.status);return r.text()}).then(function(x){var d;try{d=JSON.parse(x)}catch(e){d=x}if(Array.isArray(d))d=d[0];var o=(d&&typeof d==='object')?(d.output||d.text||d.message):d;if(!o||typeof o!=='string')throw new Error('leer');w.className='m a';w.textContent='';render(w,o);w.appendChild(fbBox())}).catch(function(){w.className='m a err';w.textContent='Der KI-Kompass ist gerade nicht erreichbar. Bitte versuchen Sie es in einem Moment erneut.'}).then(function(){busy=false;inp.disabled=snd.disabled=false;inp.focus();down()})}document.getElementById('f').onsubmit=function(e){e.preventDefault();var v=inp.value;inp.value='';inp.style.height='auto';ask(v)};inp.addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();document.getElementById('f').requestSubmit()}});inp.addEventListener('input',function(){inp.style.height='auto';inp.style.height=Math.min(inp.scrollHeight,160)+'px'});Array.prototype.forEach.call(document.querySelectorAll('#ex button'),function(b){b.onclick=function(){ask(b.textContent)}});try{var s=localStorage.getItem('kk-theme');if(s)document.documentElement.setAttribute('data-theme',s)}catch(e){}document.getElementById('tg').onclick=function(){var t=document.documentElement.getAttribute('data-theme');var d=t?t==='dark':matchMedia('(prefers-color-scheme: dark)').matches;var n=d?'light':'dark';document.documentElement.setAttribute('data-theme',n);try{localStorage.setItem('kk-theme',n)}catch(e){}};</script></body></html>",
